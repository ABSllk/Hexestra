{
  "name": "hexestra",
  "version": "0.2.1",
  "private": true,
  "description": "Human-AI penetration testing IDE with controlled autonomy and existing-tool integration",
  "author": "ABSllk",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "cybersecurity",
    "electron",
    "penetration-testing",
    "security-tools"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && node scripts/start-electron-dev.mjs\"",
    "electron:build": "npm run prepare:mitmproxy && npm run electron:compile && npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cdp-smoke.ps1",
    "test:browser-smoke": "npm run electron:compile && electron scripts/browser-automation-smoke.mjs",
    "test:browser-service-smoke": "npm run electron:compile && electron scripts/browser-service-smoke.mjs",
    "test:startup": "npm run electron:compile && npm run build && electron --disable-gpu --no-sandbox scripts/electron-startup-smoke.mjs",
    "test:traffic-proxy-smoke": "npm run electron:compile && node scripts/traffic-proxy-smoke.mjs",
    "build:burp-bridge": "node scripts/build-burp-bridge.mjs",
    "prepare:mitmproxy": "node scripts/prepare-mitmproxy-runtime.mjs",
    "release:hashes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-release-hashes.ps1",
    "release:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-public-source.ps1",
    "test:terminal-remount": "npm run electron:compile && node scripts/terminal-remount-smoke.mjs",
    "test:wsl-agent": "npm run electron:compile && node scripts/wsl-agent-smoke.mjs",
    "audit:public": "node scripts/audit-public-boundary.mjs",
    "check": "npm run typecheck && npm run test && npm run electron:compile && npm run build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/verify-native-prebuilds.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.212",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.50.0",
    "playwright-core": "1.62.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "1.17.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.0",
    "concurrently": "^9.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.hexestra.app",
    "productName": "Hexestra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/mitmproxy",
        "to": "mitmproxy",
        "filter": [
          "hexestra_addon.py",
          "LICENSE",
          "README.md",
          "bin/**/*"
        ]
      },
      {
        "from": "resources/burp-bridge",
        "to": "burp-bridge"
      },
      {
        "from": "src/assets/branding/hexestra-mark.png",
        "to": "hexestra-mark.png"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "src/assets/branding/hexestra-mark.png",
      "binaries": [
        "Contents/Resources/mitmproxy/bin/mitmproxy.app/Contents/MacOS/mitmdump"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/branding/hexestra-mark.png",
      "signExts": [
        "!mitmdump.exe"
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/branding/hexestra-mark.png"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "ssh2@1.17.0": false,
    "cpu-features@0.0.10": false
  }
}
